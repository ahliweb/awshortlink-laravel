# AW Shortlink — example environment. Copy to .env (never commit .env) or use scripts/configure-env.sh.
# Every value below is a placeholder; there are no working defaults for secrets or credentials.

APP_NAME="AW Shortlink"
APP_ENV=production
# Generate: php -r 'echo "base64:" . base64_encode(random_bytes(32)) . PHP_EOL;'
APP_KEY=
APP_DEBUG=false
# Public base URL including the path prefix. Must be https in production (QR codes and links are built from it).
APP_URL=https://links.example.org/buka
APP_TIMEZONE=UTC

# --- Deployment identity (nothing about your organisation is hard-coded in the source) -------------------------
BRAND_ORG_NAME="Your Organization"
BRAND_ORG_SHORT="Your Org"
# Code of the root organisational unit created on first migration (A-Z, 0-9, _).
BRAND_ROOT_UNIT_CODE=ROOT
# Optional logo for the favicon / QR centre: local PNG path (default public/assets/images/brand-logo.png)
# BRAND_LOGO_PATH=
# Optional absolute URL used in og:image / icons (default <APP_URL>/assets/images/brand-logo.png)
# BRAND_LOGO_URL=

# Protected baseline accounts are seeded 'invited' with NO credentials; activate with
#   php artisan admin:bootstrap <email>
SHORTLINK_OWNER_EMAIL=platform-owner@example.invalid
SHORTLINK_APPROVER_EMAIL=security-approver@example.invalid

# --- Destination policy -----------------------------------------------------------------------------------------
# Hosts you own/trust, comma-separated, wildcards allowed. EMPTY by default: nothing is auto-trusted.
# Do not allowlist hosts where anyone can publish content (file sharing, form builders, URL shorteners).
SHORTLINK_ALLOWLIST_HOSTS=
SHORTLINK_MEDIUM_RISK_SUFFIXES=.go.id,.ac.id

# --- Reverse proxy / CDN ----------------------------------------------------------------------------------------
# IPs/CIDRs of proxies whose X-Forwarded-For / CF-Connecting-IP you trust. EMPTY = trust none (REMOTE_ADDR is used).
# Behind Cloudflare, list Cloudflare's published ranges here; otherwise leave empty. Setting this wrongly lets
# clients spoof their IP and weaken brute-force protection.
TRUSTED_PROXIES=

# --- PostgreSQL ONLY (ADR-0005): SQLite/MySQL/MariaDB are rejected. No default passwords exist. -----------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=awshortlink
DB_SCHEMA=shortlink
DB_USERNAME=awshortlink_app
DB_PASSWORD=
DB_SSLMODE=prefer
# Least-privilege resolver role (SELECT on public_resolvable_links + EXECUTE record_click)
DB_RESOLVER_USERNAME=awshortlink_resolver
DB_RESOLVER_PASSWORD=
# Operator-only migration role (never used by web requests)
DB_MIGRATOR_USERNAME=awshortlink_migrator
DB_MIGRATOR_PASSWORD=

# --- Logging, session & MFA ---------------------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ABSOLUTE_LIFETIME=480
SESSION_PATH=/buka
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
MFA_TOTP_REQUIRED=true

# --- Privacy & analytics (ADR-0003: aggregate-only by default) ---------------------------------------------------
# Per-visitor telemetry (link_access_logs) is OFF. Turning it on stores truncated IP (IPv4 /24, IPv6 /48), coarse
# geo (only when a trusted proxy supplies it), OS/browser/device, and the Referer ORIGIN. Rows older than
# ANALYTICS_ACCESS_LOG_RETENTION_DAYS are purged by `php artisan schedule:run`. Check your privacy law first.
ANALYTICS_RAW_EVENTS_ENABLED=false
ANALYTICS_STORE_FULL_IP=false
ANALYTICS_ACCESS_LOG_RETENTION_DAYS=90
ANALYTICS_COHORT_SUPPRESSION_K=10
ANALYTICS_RETENTION_DAILY_MONTHS=13

# Optional SSRF-safe health checker (disabled unless safe egress is verified)
HEALTH_CHECKER_ENABLED=false
HEALTH_CHECKER_TIMEOUT_MS=3000
