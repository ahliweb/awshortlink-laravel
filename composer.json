{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "ahliweb/awshortlink-laravel",
    "type": "project",
    "version": "1.1.0",
    "description": "AW Shortlink — security-first, self-hosted short URL, dynamic QR, managed RBAC/ABAC and privacy-preserving analytics on PHP 8.3 and PostgreSQL with mandatory row-level security.",
    "keywords": [
        "awshortlink",
        "url-shortener",
        "qr-code",
        "postgresql-rls",
        "rbac",
        "abac",
        "privacy",
        "self-hosted"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-ctype": "*",
        "ext-gd": "*",
        "ext-hash": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "chillerlan/php-qrcode": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "ci": "bash scripts/ci.sh",
        "smoke": "bash scripts/smoke.sh",
        "test": [
            "@smoke"
        ],
        "build:artifact": "bash scripts/build-artifact.sh",
        "build:release-zip": "bash scripts/build-release-zip.sh",
        "ops:rls-verify": "php artisan rls:verify",
        "ops:audit-verify": "php artisan audit:verify"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
